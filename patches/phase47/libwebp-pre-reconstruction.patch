diff --git a/src/dec/frame_dec.c b/src/dec/frame_dec.c
index 8780772..164b830 100644
--- a/src/dec/frame_dec.c
+++ b/src/dec/frame_dec.c
@@ -28,0 +29,8 @@
+static WebPPhase47RowCallback phase47_row_callback;
+static void* phase47_row_context;
+
+void WebPPhase47SetRowCallback(WebPPhase47RowCallback callback, void* context) {
+  phase47_row_callback = callback;
+  phase47_row_context = context;
+}
+
@@ -513,0 +522,7 @@ int VP8ProcessRow(VP8Decoder* const dec, VP8Io* const io) {
+  if (phase47_row_callback != NULL) {
+    phase47_row_callback(dec->pic_hdr.width, dec->pic_hdr.height,
+                         dec->mb_y, dec->mb_w,
+                         sizeof(*dec->mb_data) * dec->mb_w, dec->mb_data,
+                         sizeof(dec->dqm), dec->dqm, phase47_row_context);
+    return (dec->mb_y < dec->mb_h - 1);
+  }
