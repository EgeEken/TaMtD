+#define PHASE47_FEATURES 62
+static AOMPhase47StageCallback phase47_callback;
+static void* phase47_callback_context;
+static int phase47_parse_enabled;
+static int phase47_grid_width;
+static int phase47_grid_height;
+static float* phase47_features;
+static float* phase47_counts;
+static float* phase47_chroma_modes;
+
+void aom_phase47_set_stage_callback(AOMPhase47StageCallback callback, void* context) {
+  phase47_callback = callback;
+  phase47_callback_context = context;
+}
+void aom_phase47_set_parse_only(int enabled) { phase47_parse_enabled = enabled; }
+int av1_phase47_parse_only(void) { return phase47_parse_enabled; }
+
+int av1_phase47_reset_grid(int width, int height) {
+  const int grid_width = (width + 15) / 16;
+  const int grid_height = (height + 15) / 16;
+  const size_t cells = (size_t)grid_width * grid_height;
+  free(phase47_features); free(phase47_counts); free(phase47_chroma_modes);
+  phase47_features = (float*)calloc(cells * PHASE47_FEATURES, sizeof(float));
+  phase47_counts = (float*)calloc(cells * 9, sizeof(float));
+  phase47_chroma_modes = (float*)calloc(cells * 8, sizeof(float));
+  if (phase47_features == NULL || phase47_counts == NULL || phase47_chroma_modes == NULL) {
+    free(phase47_features); free(phase47_counts); free(phase47_chroma_modes);
+    phase47_features = NULL; phase47_counts = NULL; phase47_chroma_modes = NULL;
+    return 0;
+  }
+  phase47_grid_width = grid_width; phase47_grid_height = grid_height;
+  return 1;
+}
+
+static int phase47_mode_category(PREDICTION_MODE mode, int inter) {
+  if (inter) return 6;
+  if (mode == DC_PRED) return 0;
+  if (mode == V_PRED) return 1;
+  if (mode == H_PRED) return 2;
+  if (mode >= D45_PRED && mode <= D67_PRED) return 3;
+  if (mode == SMOOTH_PRED || mode == SMOOTH_V_PRED || mode == SMOOTH_H_PRED) return 4;
+  if (mode == PAETH_PRED) return 5;
+  return 7;
+}
+
+static void phase47_capture_modes(const AV1_COMMON* cm, int sb_mi_row, int sb_mi_col) {
+  const int stride = cm->mi_params.mi_stride;
+  const int row_end = AOMMIN(sb_mi_row + cm->seq_params->mib_size, cm->mi_params.mi_rows);
+  const int col_end = AOMMIN(sb_mi_col + cm->seq_params->mib_size, cm->mi_params.mi_cols);
+  for (int mi_row = sb_mi_row; mi_row < row_end; ++mi_row) {
+    for (int mi_col = sb_mi_col; mi_col < col_end; ++mi_col) {
+      const int cell_x = mi_col / 4;
+      const int cell_y = mi_row / 4;
+      if (cell_x >= phase47_grid_width || cell_y >= phase47_grid_height) continue;
+      const size_t cell = (size_t)cell_y * phase47_grid_width + cell_x;
+      const size_t base = cell * PHASE47_FEATURES;
+      const size_t count = cell * 9;
+      const size_t uv = cell * 8;
+      MB_MODE_INFO* mbmi = cm->mi_params.mi_grid_base[mi_row * stride + mi_col];
+      if (mbmi == NULL) continue;
+      const int category = phase47_mode_category(mbmi->mode, is_inter_block(mbmi));
+      const int uv_category = phase47_mode_category(get_uv_mode(mbmi->uv_mode), 0);
+      phase47_features[base + 34 + category] += 1.0f;
+      phase47_chroma_modes[uv + uv_category] += 1.0f;
+      phase47_features[base + 26] += (float)mbmi->current_qindex;
+      phase47_features[base + 43] += !is_inter_block(mbmi) && block_size_wide[mbmi->bsize] <= 16 && block_size_high[mbmi->bsize] <= 16;
+      phase47_features[base + 44] += mbmi->skip_txfm != 0;
+      phase47_features[base + 45] += (float)mbmi->segment_id;
+      phase47_counts[count] += 1.0f;
+      phase47_counts[count + 1] += 1.0f;
+    }
+  }
+}
+
+void av1_phase47_add_coeff(int x, int y, int plane, int log_width, int log_height, const int32_t low_frequency[8], int coefficient_count, int nonzero_count) {
+  if (!av1_phase47_parse_only() || phase47_features == NULL || plane < 0 || plane > 2 || x < 0 || y < 0) return;
+  const int cell_x = x / 16;
+  const int cell_y = y / 16;
+  if (cell_x >= phase47_grid_width || cell_y >= phase47_grid_height) return;
+  const size_t cell = (size_t)cell_y * phase47_grid_width + cell_x;
+  const size_t base = cell * PHASE47_FEATURES;
+  const size_t count = cell * 9;
+  const int coeff_base = 2 + plane * 8;
+  for (int i = 0; i < 8; ++i) phase47_features[base + coeff_base + i] += (float)low_frequency[i];
+  phase47_counts[count + 2 + plane] += 1.0f;
+  phase47_counts[count + 5] += 1.0f;
+  phase47_features[base + 48] += (float)log_width;
+  phase47_features[base + 49] += (float)log_height;
+  phase47_features[base + (plane == 0 ? 46 : 47)] += (float)nonzero_count;
+  phase47_features[base + 53 + plane] += (float)coefficient_count;
+  phase47_counts[count + 6 + plane] += (float)coefficient_count;
+}
+
+void av1_phase47_emit(int width, int height) {
+  if (!av1_phase47_parse_only() || phase47_callback == NULL || phase47_features == NULL) return;
+  const size_t cells = (size_t)phase47_grid_width * phase47_grid_height;
+  for (int y = 0; y < phase47_grid_height; ++y) {
+    for (int x = 0; x < phase47_grid_width; ++x) {
+      const size_t cell = (size_t)y * phase47_grid_width + x;
+      const size_t base = cell * PHASE47_FEATURES;
+      const size_t count = cell * 9;
+      const size_t uv = cell * 8;
+      const float mode_count = phase47_counts[count];
+      phase47_features[base] = phase47_grid_width > 1 ? (float)x / (phase47_grid_width - 1) : 0.0f;
+      phase47_features[base + 1] = phase47_grid_height > 1 ? (float)y / (phase47_grid_height - 1) : 0.0f;
+      if (phase47_counts[count + 1] > 0) phase47_features[base + 26] /= phase47_counts[count + 1];
+      if (mode_count > 0) {
+        phase47_features[base + 43] /= mode_count;
+        phase47_features[base + 44] /= mode_count;
+        phase47_features[base + 45] /= mode_count;
+      }
+      int chroma_mode = 0;
+      for (int mode = 1; mode < 8; ++mode)
+        if (phase47_chroma_modes[uv + mode] > phase47_chroma_modes[uv + chroma_mode]) chroma_mode = mode;
+      phase47_features[base + 42] = (float)chroma_mode;
+      phase47_features[base + 61] = mode_count > 0;
+      for (int plane = 0; plane < 3; ++plane) {
+        const float coeff_count = phase47_counts[count + 2 + plane];
+        const int coeff_base = 2 + plane * 8;
+        if (coeff_count > 0)
+          for (int i = 0; i < 8; ++i) phase47_features[base + coeff_base + i] /= coeff_count;
+        phase47_features[base + 50 + plane] = coeff_count > 0;
+      }
+      phase47_features[base + 46] = phase47_counts[count + 6] > 0 ? phase47_features[base + 46] / phase47_counts[count + 6] : 0.0f;
+      phase47_features[base + 47] = phase47_counts[count + 7] + phase47_counts[count + 8] > 0 ? phase47_features[base + 47] / (phase47_counts[count + 7] + phase47_counts[count + 8]) : 0.0f;
+      if (phase47_counts[count + 5] > 0) {
+        phase47_features[base + 48] /= phase47_counts[count + 5];
+        phase47_features[base + 49] /= phase47_counts[count + 5];
+      }
+      for (int i = 53; i < 61; ++i) phase47_features[base + i] = 0.0f;
+      phase47_features[base + 53] = phase47_counts[count + 1] > 0;
+    }
+  }
+  phase47_callback(width, height, phase47_grid_width, phase47_grid_height, phase47_features, cells * PHASE47_FEATURES, phase47_callback_context);
+}
+
@@ -2819,0 +2959 @@ static inline void decode_tile(AV1Decoder *pbi, ThreadData *const td,
+      if (av1_phase47_parse_only()) phase47_capture_modes(cm, mi_row, mi_col);
@@ -2920 +3060 @@ static const uint8_t *decode_tiles(AV1Decoder *pbi, const uint8_t *data,
-  set_decode_func_pointers(&pbi->td, 0x3);
+  set_decode_func_pointers(&pbi->td, av1_phase47_parse_only() ? 0x1 : 0x3);
@@ -5372,0 +5513,5 @@ void av1_decode_tg_tiles_and_wrapup(AV1Decoder *pbi, const uint8_t *data,
+  if (initialize_flag && av1_phase47_parse_only() &&
+      !av1_phase47_reset_grid(cm->width, cm->height)) {
+    aom_internal_error(&pbi->error, AOM_CODEC_MEM_ERROR,
+                       "Phase 4.7 AV1 stage grid allocation failed");
+  }
@@ -5398,0 +5544,7 @@ void av1_decode_tg_tiles_and_wrapup(AV1Decoder *pbi, const uint8_t *data,
+  if (av1_phase47_parse_only()) {
+    if (pbi->dcb.corrupted)
+      aom_internal_error(&pbi->error, AOM_CODEC_CORRUPT_FRAME,
+                         "Failed to parse AV1 stage data");
+    av1_phase47_emit(cm->width, cm->height);
+    return;
+  }
